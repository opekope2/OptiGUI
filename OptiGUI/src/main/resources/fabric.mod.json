{
  "schemaVersion": 1,
  "id": "optigui",
  "version": "$version",
  "name": "OptiGUI",
  "description": "Blazing fast custom GUI textures on Fabric and Quilt with built-in OptiFine custom GUI resource pack support",
  "authors": [
    {
      "name": "opekope2",
      "contact": {
        "homepage": "https://opekope2.dev",
        "github": "https://github.com/opekope2"
      }
    }
  ],
  "contributors": [
    {
      "name": "dirtTW",
      "contact": {
        "github": "https://github.com/yichifauzi"
      }
    },
    {
      "name": "notlin4",
      "contact": {
        "github": "https://github.com/notlin4"
      }
    },
    {
      "name": "Lucanoria",
      "contact": {
        "github": "https://github.com/Lucanoria"
      }
    },
    {
      "name": "LyriaWintona",
      "contact": {
        "github": "https://github.com/LyriaWintona"
      }
    },
    {
      "name": "RoberbufDx8105",
      "contact": {
        "github": "https://github.com/RoberbufDx8105"
      }
    },
    {
      "name": "NuruddinPlays",
      "contact": {
        "github": "https://github.com/NuruddinPlays"
      }
    },
    {
      "name": "gorr0w7",
      "contact": {
        "github": "https://github.com/gorr0w7"
      }
    }
  ],
  "contact": {
    "homepage": "https://opekope2.dev/OptiGUI",
    "sources": "https://github.com/opekope2/OptiGUI",
    "issues": "https://github.com/opekope2/OptiGUI/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/optigui/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "opekope2.optigui.internal.fabric.OptiGuiClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "opekope2.optigui.internal.fabric.ModMenuIntegration"
      }
    ]
  },
  "mixins": [
    "optigui.mixins.json",
    "optigui-vanilla-screen-info.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": ">=$fabric_api",
    "fabric-language-kotlin": ">=$fabric_language_kotlin",
    "minecraft": ">=$minecraft <1.21.2",
    "java": ">=$java",
    "cloth-config": ">=$cloth_config"
  },
  "custom": {
    "mc-publish": {
      "loaders": [
        "fabric",
        "quilt"
      ]
    }
  }
}
