// Translations can be added as either a .json file (with no comments) or as a .jsonc (with comments).
// Multi-line comments are not supported, even within the same line.
// Single-line comments are only supported on their own lines, not at the end of translation lines.
// OptiGUI uses a gradle resource processor to strip comments and rename .jsonc to .json during compilation.

{
  /////////////////////////////////////
  // OptiGUI resource pack converter //
  /////////////////////////////////////

  "optigui.gui.rp_converter.conversion_fail": "OptiGUI couldn't convert some resources",
  "optigui.gui.rp_converter.conversion_success": "Resource pack converted successfully",
  "optigui.gui.rp_converter.convert": "Convert resource pack",
  "optigui.gui.rp_converter.convert_ini": "Convert OptiGUI .ini",
  "optigui.gui.rp_converter.convert_properties": "Convert OptiFine .properties",
  "optigui.gui.rp_converter.converting": "Converting resource pack",
  "optigui.gui.rp_converter.description": "Convert OptiFine .properties and OptiGUI .ini to OptiGUI JSON resources",
  "optigui.gui.rp_converter.output_file": "Output file name",
  // Namespace refers to https://minecraft.wiki/w/Resource_location#Namespaces
  "optigui.gui.rp_converter.target_namespace": "Target namespace",
  "optigui.gui.rp_converter.title": "OptiGUI Resource Pack Converter",

  /////////////////////////////////////////
  // OptiGUI resource loading log screen //
  /////////////////////////////////////////

  "optigui.gui.rp_loader.do_not_show_again": "Do not show again",
  "optigui.gui.rp_loader.do_not_show_again.tooltip": "You can change this anytime in OptiGUI settings",
  "optigui.gui.rp_loader.load_fail": "OptiGUI couldn't load some resources",
  "optigui.gui.rp_loader.unknown_pack": "Unknown resource pack",
  "optigui.gui.rp_loader.unknown_resource": "Unknown resource",


  //////////////////////////////
  // OptiGUI Inspector button //
  //////////////////////////////

  "optigui.inspector": "OptiGUI Inspector",

  "optigui.inspector.description": "Click to generate a JSON resource",
  "optigui.inspector.description.clicked": "JSON resource copied to clipboard",
  "optigui.inspector.description.debug": "Click to open the filter debugger",
  "optigui.inspector.description.hide": "You can hide this in OptiGUI settings",

  "optigui.inspector.key.more_info": "Hold %s for more information",

  "optigui.inspector.nbt_dumping_disabled": "NBT dumping is disabled in OptiGUI settings",

  "optigui.inspector.title": "OptiGUI (%s)",
  "optigui.inspector.title.alpha": "OptiGUI alpha (%s)",
  "optigui.inspector.title.beta": "OptiGUI beta (%s)",
  "optigui.inspector.title.custom_textures": "custom textures",
  "optigui.inspector.title.original_textures": "original textures",


  /////////////////////////////
  // OptiGUI resource loader //
  /////////////////////////////

  "optigui.rp_loader.info.load_success": "Loaded resource",
  "optigui.rp_loader.info.load_time_filtered": "Skipping resource because of load-time filter",
  "optigui.rp_loader.info.loading_resource": "Loading resource",

  "optigui.rp_loader.warn.missing_sprites": "Missing sprites: %s",
  "optigui.rp_loader.warn.missing_textures": "Missing textures: %s",
  // blocks, entities, items, inventory, and unknown are parts of JSON resources, so these shouldn't be translated
  "optigui.rp_loader.warn.no_interaction_target": "No interaction targets (blocks, entities, items, inventory, unknown) were specified",
  "optigui.rp_loader.warn.no_textures_or_sprites": "No valid textures or sprites were specified",


  ////////////////////////////////////////////
  // DataFixerUpper codec validation errors //
  ////////////////////////////////////////////
  // OptiGUI uses DataFixerUpper codecs to parse supported resource formats.
  // Mojang's DataFixerUpper library is not localized. These will result in mixed language error messages.
  // I may create a mod that enables localizing DataFixerUpper if I have time, or remove these altogether for English-only messages.

  "optigui.validation.error.duplicate_filters": "Duplicate filters: %s",

  "optigui.validation.error.no_filter": "No such filter: %s",
  "optigui.validation.error.no_filter_type": "No such filter type: %s",

  "optigui.validation.error.not_a_number": "Not a number: %s",
  "optigui.validation.error.not_a_number_or_string": "Not a number or string: %s",
  // Relative resource location refers to an OptiGUI-specific variant of https://minecraft.wiki/w/Resource_location, so ./texture.png can be used instead of namespace:path/to/texture.png
  "optigui.validation.error.not_a_relative_identifier": "Not a relative resource location: %s",
  "optigui.validation.error.not_an_nbt_transformer": "Not an NBT transformer: %s",

  "optigui.validation.error.of_incompatible_variants": "Incompatible variants: %s",
  "optigui.validation.error.of_invalid_bool": "Invalid boolean: %s",
  "optigui.validation.error.of_invalid_profession": "Invalid villager profession: %s",
  "optigui.validation.error.of_invalid_range": "Invalid range: %s",
  // texture.PATH is documented at https://optifine.readthedocs.io/custom_guis.html#texture-texture-path, so it should not be translated
  "optigui.validation.error.of_texture_required": "At least one texture or texture.PATH is required",

  "optigui.validation.error.unsupported_filter": "Unsupported filter: %s",

  "optigui.validation.error.wrong_filter_type": "Expected filter type %s, got %s",


  ////////////////////
  // OptiGUI config //
  ////////////////////

  // Dump (verb)
  "text.config.optigui.option.dumpNbt": "Dump NBT",
  "text.config.optigui.option.dumpNbt.tooltip": "Include NBT data in generated JSON resources",
  // As in OFF, not as in IMPAIRED
  // Does not include NBT data in the JSON resource generated by OptiGUI Inspector.
  "text.config.optigui.option.dumpNbt.value.nothing": "Disabled",
  // Includes NBT data values and types in the JSON resource generated by OptiGUI Inspector.
  "text.config.optigui.option.dumpNbt.value.values_and_types": "Values & types",
  // Includes NBT data values in the JSON resource generated by OptiGUI Inspector.
  "text.config.optigui.option.dumpNbt.value.values_only": "Values only",

  "text.config.optigui.option.enableInspector": "Enable inspector",
  "text.config.optigui.option.enableInspector.tooltip": "Show an inspector button on supported inventory screens",

  "text.config.optigui.option.interactWithAttackKey": "Interact using the attack key",
  "text.config.optigui.option.interactWithAttackKey.tooltip": "In addition to the use key, attacking also starts an interaction\n§8Some servers may open a screen menu when attacking an entity",

  "text.config.optigui.option.keepInteractionFactory": "Remember last interaction",
  "text.config.optigui.option.keepInteractionFactory.tooltip": "Do not end interaction when the screen closes\n§8Some servers may open other menu screens from a menu screen",

  "text.config.optigui.option.showResourceLoadingErrors": "Show resource loading logs",
  "text.config.optigui.option.showResourceLoadingErrors.tooltip": "Show logs when OptiGUI fails to load a resource",
  // Show OptiGUI resource loading log if errors or warnings are logged.
  "text.config.optigui.option.showResourceLoadingErrors.value.errors_and_warnings": "Errors & warnings",
  // Show OptiGUI resource loading log only if errors are logged.
  "text.config.optigui.option.showResourceLoadingErrors.value.errors_only": "Errors only",
  // Never show OptiGUI resource loading log, even when errors are logged.
  "text.config.optigui.option.showResourceLoadingErrors.value.nothing": "Never",

  "text.config.optigui.section.inspector": "Inspector",
  "text.config.optigui.section.interaction": "Interaction",
  "text.config.optigui.section.resourceLoading": "Resource loading",

  "text.config.optigui.title": "OptiGUI Settings",

  // Refers to the tools provided by OptiGUI: Show resource loading logs, resource pack converter
  "text.config.optigui.tools": "Utilities",
  "text.config.optigui.tools.rp_converter": "Resource Pack Converter",
  "text.config.optigui.tools.resource_loading_logs": "Resource loading logs"
}
